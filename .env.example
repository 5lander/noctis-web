# Noctis Web — variables de entorno
#
# Copiar a `.env.local` para desarrollo. `.env*` está en .gitignore: nunca se versiona
# un archivo con valores reales. Este ejemplo solo contiene valores de demostración.
#
# Regla dura (CLAUDE.md RN10): con MODO_SERVICIOS=real, si falta una credencial la
# aplicación NO arranca y dice cuál falta. Jamás cae a simulado en silencio.
# Las credenciales llegan en P4 (puertos y adaptadores) y P12 (servicios reales).

# ── Selector global de adaptadores ───────────────────────────────────────────
# demo → nada sale a internet, nada cuesta dinero, no hacen falta credenciales
# real → se exigen las credenciales de cada servicio
MODO_SERVICIOS=demo

# ── Selectores por servicio (sobrescriben el global) ─────────────────────────
# Permiten pasar a real un servicio a la vez (P12), dejando el resto simulado.
# Si se omiten, cada uno sigue a MODO_SERVICIOS.
CALENDARIO_ADAPTER=fake
CORREO_ADAPTER=fake
CHAT_ADAPTER=fake
ALMACEN_ADAPTER=memoria

# ── Portafolio: clientes y trabajos que se cargan desde /admin ───────────────
# sqlite  → base en disco. Es el valor por omisión y lo que quiere producción.
# memoria → sin persistencia; para pruebas y para el modo demostración.
#
# QUÉ EXIGE DEL HOSTING: disco escribible y persistente. Lo cumple un VPS, un
# plan Node de cPanel, Railway, Render o Fly. NO lo cumple un despliegue sin
# servidor (Vercel, Netlify Functions), donde el disco se borra en cada
# invocación: ahí hay que escribir un adaptador de PostgreSQL detrás del mismo
# puerto. No hay que tocar ni el dominio ni la página.
# sqlite       los trabajos se cargan desde /admin y viven en disco (produccion)
# memoria      vacio: la seccion de trabajos no se pinta
PORTAFOLIO_ADAPTER=sqlite

# El archivo y la carpeta de subidas tienen que quedar FUERA de lo que borra un
# despliegue. Si el hosting reemplaza la carpeta de la aplicación al publicar,
# usar rutas absolutas a un volumen que sobreviva, por ejemplo:
#   SQLITE_RUTA=/home/usuario/datos-noctis/noctis.db
#   MEDIOS_RUTA=/home/usuario/datos-noctis/medios
SQLITE_RUTA=./data/noctis.db
MEDIOS_RUTA=./data/medios

# ── Panel de administración ──────────────────────────────────────────────────
# SIN ADMIN_CLAVE Y ADMIN_SECRETO EL PANEL NO EXISTE: /admin devuelve 404. Es
# deliberado — un panel apagado no se puede forzar.
# ADMIN_CLAVE: mínimo 12 caracteres. Es lo único entre internet y el contenido.
# ADMIN_SECRETO: mínimo 24 caracteres, aleatorio. Firma la cookie de sesión.
#   Generarlo con:  node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
#   Cambiarlo cierra todas las sesiones abiertas.
ADMIN_CLAVE=
ADMIN_SECRETO=

# ── Identidad pública del sitio ──────────────────────────────────────────────
# SITIO_URL alimenta canonical, Open Graph y el sitemap. TIENE QUE ESTAR PUESTA
# DURANTE `npm run build`: robots.txt y sitemap.xml se generan en ese momento, y
# sin ella salen sin la línea de sitemap y con la lista vacía.
SITIO_URL=

# El número de WhatsApp ya no se configura acá: vive en `src/content/site.ts`,
# porque es un dato público que la página pinta y no una credencial de despliegue.

# ── Interruptores de superficie ──────────────────────────────────────────────
# Apagan una funcionalidad sin desplegar código nuevo.
BOT_ACTIVO=false
AGENDADOR_ACTIVO=true

# ── Credenciales (P12) ───────────────────────────────────────────────────────
# NO se ponen en demo. Se exigen solo del servicio que se pase a real, y si
# falta una la aplicación no arranca y dice cuál (RN10). Los nombres viven en
# `src/shared/infrastructure/config/credentials.ts`.
#
# Calendario:  GOOGLE_CALENDAR_ID · GOOGLE_SERVICE_ACCOUNT_EMAIL · GOOGLE_PRIVATE_KEY
# Correo:      BREVO_API_KEY · BREVO_SENDER_EMAIL
# Modelo:      MODELO_API_KEY · MODELO_NOMBRE · MODELO_TOPE_MENSUAL_USD
# Almacén:     DATABASE_URL
